# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: SIGA-COMUNITARIO (APP AGUA)
# ==============================================================================

# Entorno de ejecución y puerto del servidor
PORT=4000
NODE_ENV=development

# Clave secreta para generación de tokens JWT
JWT_SECRET=siga-comunitario-super-secret-key-2026-offline-first

# ==============================================================================
# CONFIGURACIÓN DE SUPABASE (NUEVAS Y CLÁSICAS CREDENCIALES)
# ==============================================================================
# URL del Proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave Pública / Publishable (equivalente a ANON KEY)
SUPABASE_PUBLISHABLE_KEY=tu_publishable_key_aqui

# Clave Secreta / Secret (equivalente a SERVICE ROLE KEY, requerida para backend)
SUPABASE_SECRET_KEY=tu_secret_key_aqui

# JWKS URL (Opcional, para verificación de tokens Supabase Auth)
SUPABASE_JWKS_URL=

# Nombres alternativos compatibles:
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
