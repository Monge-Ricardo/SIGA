  "item": [
    {
      "name": "1. Autenticación (Auth)",
      "item": [
        {
          "name": "Login - Cajero / Tesorero (Operador Principal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.environment.set('jwtToken', json.token);",
                  "  console.log('jwtToken guardado:', json.token);",
                  "}",
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Usuario tiene rol CAJERO', () => pm.expect(json.usuario.rol).to.eql('CAJERO'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"cajero\",\n  \"password\": \"Cajero123*\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login - Administrador (Gobernanza)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.environment.set('adminToken', json.token);",
                  "  pm.environment.set('jwtToken', json.token);",
                  "}",
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123*\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login - Lector (Micromedición)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
