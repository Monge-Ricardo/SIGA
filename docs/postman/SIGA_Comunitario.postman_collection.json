                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Consumo calculado correctamente (45m3)', () => pm.expect(json.data.consumoTotal).to.eql(45));",
                  "pm.test('Excedente calculado (>30m3 -> 15m3)', () => pm.expect(json.data.excedenteM3).to.eql(15));"
                ],
                "type": "text/javascript"
              }
            }
