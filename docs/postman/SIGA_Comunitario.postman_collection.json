    {
      "name": "6. Facturación y Cobros en Caja",
      "item": [
        {
          "name": "Registrar Multa por Minga / Cuota Extra",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idSocio\": \"{{socioId}}\",\n  \"tipoRubro\": \"MINGA\",\n  \"monto\": 3.00,\n  \"motivo\": \"Inasistencia a minga de limpieza de captación\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/multas", "host": ["{{baseUrl}}"], "path": ["multas"] }
          }
        },
        {
          "name": "Liquidar Factura Mensual del Socio",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.environment.set('facturaId', json.data.id);",
                  "  pm.test('Base es $7.00', () => pm.expect(json.data.valorBase).to.eql(7));",
                  "  pm.test('Excedente 15m3 * $0.10 = $1.50', () => pm.expect(json.data.valorExcedente).to.eql(1.5));",
                  "  pm.test('Alcantarillado = $1.00', () => pm.expect(json.data.valorAlcantarillado).to.eql(1));",
                  "  pm.test('Multa = $3.00', () => pm.expect(json.data.valorMultas).to.eql(3));",
                  "  pm.test('Total mes = $9.50', () => pm.expect(json.data.totalMes).to.eql(9.5));",
                  "  pm.test('Total pagar = $12.50', () => pm.expect(json.data.totalPagar).to.eql(12.5));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idSocio\": \"{{socioId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/facturas/liquidar", "host": ["{{baseUrl}}"], "path": ["facturas", "liquidar"] }
          }
        },
